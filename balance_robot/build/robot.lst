 125:application/robot_task.h **** __attribute__((noreturn)) void StartROBOTTASK(void const *argument)
 126:application/robot_task.h **** {
 127:application/robot_task.h ****     static float robot_dt;
 128:application/robot_task.h ****     static float robot_start;
 129:application/robot_task.h ****     LOGINFO("[freeRTOS] ROBOT core Task Start");
 130:application/robot_task.h ****     // 200Hz-500Hz,若有额外的控制任务如平衡步兵可能需要提升至1kHz
 131:application/robot_task.h ****     for (;;)
 132:application/robot_task.h ****     {
 133:application/robot_task.h ****         robot_start = DWT_GetTimeline_ms();
 134:application/robot_task.h ****         RobotTask();
 135:application/robot_task.h ****         robot_dt = DWT_GetTimeline_ms() - robot_start;
 136:application/robot_task.h ****         if (robot_dt > 1)
 137:application/robot_task.h ****             LOGERROR("[freeRTOS] ROBOT core Task is being DELAY! dt = [%f]", &robot_dt);
 138:application/robot_task.h ****         osDelay(1);
 139:application/robot_task.h ****     }
 140:application/robot_task.h **** }
