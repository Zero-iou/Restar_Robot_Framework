 472:application/cmd/robot_cmd.c ****         }
 473:application/cmd/robot_cmd.c ****         else
 474:application/cmd/robot_cmd.c ****         { // 有力模式下，粉灯呼吸变化并且不报警
 475:application/cmd/robot_cmd.c ****             LEDSetStatus(led_alarm, ALARM_OFF); 
