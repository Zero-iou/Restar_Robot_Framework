 482:application/cmd/robot_cmd.c ****         if (chassis_fetch_data.motor_state == GIMBAL_MOTOR_OFFLINE)
 483:application/cmd/robot_cmd.c ****         { // 黄灯快闪，闪烁次数对应不同电机，蜂鸣器报警声为Do
